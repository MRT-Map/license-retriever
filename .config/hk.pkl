amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Builtins.pkl"
import "package://github.com/iiiii7d/hk/releases/download/v2.12.0-11/hk@2.12.0-11#/Cargo.pkl"
import "package://github.com/iiiii7d/hk/releases/download/v2.12.0-11/hk@2.12.0-11#/Misc.pkl"

local formatters = new Mapping<String, Step> {
    ["cargo_fmt"] = Cargo.fmt
}

local linters = new Mapping<String, Step> {
    ["cargo_clippy"] = Cargo.clippy
    ...Misc.zizmor.steps
    ["actionlint"] = Misc.actionlint
    ...Misc.poutine.steps
}

steps {
    ...formatters
    ...linters
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
    }
}
